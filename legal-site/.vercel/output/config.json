{
  "version": 3,
  "routes": [
    {
      "src": "^/join/([^/]+)/?$",
      "dest": "/api/join?code=$1"
    },
    {
      "src": "^/join/?$",
      "dest": "/api/join"
    },
    {
      "src": "^/\\.well-known/apple-app-site-association$",
      "headers": {
        "content-type": "application/json"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ]
}