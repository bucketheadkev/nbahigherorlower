# Production website and invitation-link base.
# Set this when deploying the website to https://1brun.com.
# Leave unset for local development and Capacitor iOS builds so the native
# app keeps the existing Universal Link host.
NEXT_PUBLIC_SITE_URL=https://1brun.com

# Local game → Supabase (use staging values while validating; never commit secrets).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Staging validation only (scripts/staging-validate.ts). Do not use production ref.
# STAGING_SUPABASE_URL=
# STAGING_SUPABASE_ANON_KEY=
# STAGING_SUPABASE_SERVICE_ROLE_KEY=
# STAGING_USER_ACCESS_TOKEN=
