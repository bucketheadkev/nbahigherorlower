import type { Position, PlayerStats, TradePlayer } from './types';

function p(
  id: string,
  name: string,
  teamId: string,
  position: Position,
  age: number,
  stats: PlayerStats,
  tradeValue: number,
  isStarter: boolean,
  isFranchise = false,
): TradePlayer {
  return { id, name, teamId, position, age, stats, tradeValue, isStarter, isFranchise };
}

